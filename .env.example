# --- Stride environment ---

# Base URL of the deployed app. Used for OpenGraph + canonical URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Path to the SQLite database file. Defaults to ./data/stride.db.
# When deploying to a serverless platform with an ephemeral filesystem,
# swap to Postgres or libSQL/Turso (see README "Deployment").
DATABASE_URL=file:./data/stride.db

# --- Future integrations (not used yet) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
